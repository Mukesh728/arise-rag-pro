# ==========================================
# MRSPTU StudyRAG - Environment Configuration
# ==========================================

# Application Settings
APP_NAME="MRSPTU StudyRAG"
APP_VERSION="1.0.0"

# LLM Provider & API Keys
# LLM_PROVIDER options: auto, gemini, openai, groq, mock
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your_gemini_api_key_here"

# Vector Store Configuration
# Options: "chroma" or "pgvector"
VECTOR_STORE_TYPE="chroma"
CHROMA_PERSIST_DIR="./chroma_db"

# Storage
UPLOAD_DIR="./uploads"

# RAG & Retrieval Parameters
SIMILARITY_THRESHOLD=0.32
RRF_K=60
DEFAULT_TOP_K=3
