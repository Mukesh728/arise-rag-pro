# ==========================================
# Arise.ai (MRSPTU StudyRAG) - Environment Configuration
# ==========================================

# Application Settings
APP_NAME="Arise"
APP_VERSION="1.0.0"

# LLM Provider & API Keys
# LLM_PROVIDER options: auto, gemini, openai, groq, mock
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash"

# Vector Store Configuration
VECTOR_STORE_TYPE="chroma"
CHROMA_PERSIST_DIR="./chroma_db"

# Storage
UPLOAD_DIR="./uploads"

# RAG & Retrieval Parameters
SIMILARITY_THRESHOLD=0.32
RRF_K=60
DEFAULT_TOP_K=5

# Neighbor-chunk expansion: after retrieval, also include ±1 page chunks in LLM context
# Set to "false" to disable
NEIGHBOR_EXPANSION=true

# --- Deployment / Security (all OPTIONAL, local dev works without them) ---

# Server port (respected by Dockerfile CMD and start scripts)
# PORT=8000

# Admin token: if set, POST /api/ingest, DELETE /api/documents/{id} require X-Admin-Token header
# ADMIN_TOKEN=

# Rate limiting: max queries per source IP per hour (uses in-memory counter, resets on restart)
# RATE_LIMIT_PER_HOUR=120

# CORS: comma-separated allowed origins; default is "*" (all)
# ALLOWED_ORIGINS=https://arise.example.com,http://localhost:3000

# Max upload size in MB (default 25)
# MAX_UPLOAD_MB=25
