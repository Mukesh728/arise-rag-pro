# ==============================================================================
# Arise.ai (MRSPTU StudyRAG) - Complete Environment Configuration Reference
# ==============================================================================
# Copy this file to '.env' and update the values according to your environment.
# In local development, all variables have safe defaults except GEMINI_API_KEY.
# When ENV=production, hardened secure defaults are automatically applied.

# ------------------------------------------------------------------------------
# 1. Application & Environment Mode
# ------------------------------------------------------------------------------
# APP_NAME: User-facing name of the application. Default: "Arise"
APP_NAME="Arise"

# APP_VERSION: Application release version. Default: "1.0.0"
APP_VERSION="1.0.0"

# ENV: Environment mode. Options: "development", "production".
# When set to "production":
#   - SESSION_SECRET is strictly required at startup (server fails to boot if unset).
#   - ENABLE_DOCS defaults to false.
#   - COOKIE_SECURE defaults to true (HTTPS only).
#   - DAILY_QUERY_LIMIT defaults to 20 per user.
#   - RATE_LIMIT_PER_HOUR defaults to 60 per IP.
#   - GLOBAL_DAILY_QUERY_LIMIT defaults to 300 demo queries across all users.
# Default: "development"
ENV="development"

# ENABLE_DOCS: Toggle FastAPI interactive documentation (/docs, /redoc, /openapi.json).
# In production (ENV=production), defaults to false for security.
# In development, defaults to true.
ENABLE_DOCS=true

# ------------------------------------------------------------------------------
# 2. LLM Provider & Credentials
# ------------------------------------------------------------------------------
# LLM_PROVIDER: LLM backend provider. Options: "auto", "gemini", "mock".
# "auto" uses Gemini when GEMINI_API_KEY is present, or mock synthesis otherwise.
# "mock" runs offline without external network calls (ideal for benchmarks and CI).
# Default: "auto"
LLM_PROVIDER="gemini"

# GEMINI_API_KEY: Google Gemini API key (from https://aistudio.google.com).
# Required for live generative responses. If empty/unset, system uses grounded fallback passages.
GEMINI_API_KEY="your_gemini_api_key_here"

# GEMINI_MODEL: Specific Gemini model variant for generation.
# Supported: "gemini-3.5-flash-lite", "gemini-3.5-flash". Default: "gemini-3.5-flash-lite"
GEMINI_MODEL="gemini-3.5-flash-lite"

# ------------------------------------------------------------------------------
# 3. Vector Database & Storage
# ------------------------------------------------------------------------------
# VECTOR_STORE_TYPE: Storage backend for vector embeddings. Options: "chroma".
# Default: "chroma"
VECTOR_STORE_TYPE="chroma"

# CHROMA_PERSIST_DIR: Local directory path where ChromaDB persists embeddings on disk.
# Default: "./chroma_db"
CHROMA_PERSIST_DIR="./chroma_db"

# UPLOAD_DIR: Local directory where uploaded syllabus and course notes PDFs are saved.
# Default: "./uploads"
UPLOAD_DIR="./uploads"

# ------------------------------------------------------------------------------
# 4. RAG Retrieval & Confidence Guardrail Parameters
# ------------------------------------------------------------------------------
# SIMILARITY_THRESHOLD: Cosine similarity cutoff [0.0 - 1.0] for the confidence guardrail.
# Queries with similarity below this threshold are rejected as ungrounded to prevent hallucination.
# Default: 0.32
SIMILARITY_THRESHOLD=0.32

# RRF_K: Ranking smoothing constant for Reciprocal Rank Fusion (Hybrid search = Vector + BM25).
# Default: 60
RRF_K=60

# DEFAULT_TOP_K: Default number of relevant chunks retrieved per user question.
# Top_k is server-side clamped to range 1..8. Default: 5
DEFAULT_TOP_K=5

# NEIGHBOR_EXPANSION: When true, retrieves surrounding ±1 page chunks from the same document
# to provide broader pedagogical context to the LLM while keeping citations precise.
# Default: true
NEIGHBOR_EXPANSION=true

# ------------------------------------------------------------------------------
# 5. Authentication & Access Control
# ------------------------------------------------------------------------------
# AUTH_ENABLED: Enforce user authentication across API and UI routes.
# When true: / requires login, /api/* endpoints require valid session (except /health and /auth/*).
# When false: allows anonymous access across all pages. Default: true
AUTH_ENABLED=true

# USERS_DB_PATH: Filepath to SQLite database storing user accounts, roles, and global quotas.
# In production containers, set to "/data/users.db" and mount a persistent volume on "/data".
# Default: "data/users.db"
USERS_DB_PATH="data/users.db"

# SESSION_SECRET: Secret key used to sign HttpOnly session cookies using HMAC-SHA256.
# REQUIRED in production when AUTH_ENABLED=true.
# Generate a cryptographically secure 256-bit key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=""

# COOKIE_SECURE: Set Secure flag on session cookies (enforces HTTPS transmission).
# In production (ENV=production), defaults to true.
# In local development HTTP, set to false. Default: false
COOKIE_SECURE=false

# ALLOW_SIGNUP: When true, users can register new accounts via /api/auth/register.
# Signups are rate-limited to 10 registrations per hour per IP.
# When false, registration is disabled and only pre-existing/admin accounts can log in. Default: true
ALLOW_SIGNUP=true

# ADMIN_EMAIL: Optional email to automatically bootstrap an administrator account on startup.
# Example: "admin@mrsptu.ac.in". Default: unset
ADMIN_EMAIL=""

# ADMIN_PASSWORD: Password for bootstrapped administrator account (minimum 8 characters).
# Plaintext is hashed with bcrypt (12 rounds) and never stored or logged. Default: unset
ADMIN_PASSWORD=""

# DAILY_QUERY_LIMIT: Maximum number of questions a single user can submit per UTC day.
# Default: 0 (unlimited) in development; 20 in production when unset.
DAILY_QUERY_LIMIT=0

# GLOBAL_DAILY_QUERY_LIMIT: Daily demo quota counted across all users per UTC day.
# Persisted in users SQLite DB, automatically resets daily.
# If exceeded, returns 429 {"detail": "Daily demo quota reached, try tomorrow"}.
# Default: 0 (unlimited) in development; 300 in production when unset.
GLOBAL_DAILY_QUERY_LIMIT=0

# ------------------------------------------------------------------------------
# 6. Deployment, Network & Security Limits
# ------------------------------------------------------------------------------
# PORT: TCP port the application listens on (used by Dockerfile CMD and start scripts).
# Default: 8000
PORT=8000

# TRUSTED_PROXY_COUNT: Number of trusted reverse proxies in front of the application
# (e.g., 1 for Render, Railway, Fly.io, or Nginx).
# Prevents client IP spoofing via X-Forwarded-For headers:
#   - 0 (default in dev): Ignores X-Forwarded-For and uses request.client.host directly.
#   - N > 0: Takes the Nth entry from the RIGHT (-N), which was appended by your trusted proxy.
# NOTE: Setting this value too high is UNSAFE (allows client IP spoofing).
# Setting this value too low is SAFE (only causes users behind the same proxy to share rate limits).
TRUSTED_PROXY_COUNT=0

# ADMIN_TOKEN: Optional secret bearer token for programmatic management (POST /ingest, DELETE /documents).
# If set, requests with matching 'X-Admin-Token' header can bypass UI login checks (for CI/CD scripts).
# Compared using constant-time hmac.compare_digest. Default: unset
ADMIN_TOKEN=""

# RATE_LIMIT_PER_HOUR: Max /api/query requests allowed per client IP per rolling 1-hour window.
# Uses get_client_ip(request) respecting TRUSTED_PROXY_COUNT.
# Default: 0 (disabled) in development; 60 in production when unset.
RATE_LIMIT_PER_HOUR=0

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins.
# Example: "https://arise.mrsptu.ac.in,http://localhost:3000". Default: "*"
ALLOWED_ORIGINS="*"

# MAX_UPLOAD_MB: Maximum allowed syllabus PDF file size in megabytes.
# Uploads exceeding this limit receive a 413 Payload Too Large response. Default: 25
MAX_UPLOAD_MB=25
