# ==============================================================================
# Arise.ai (MRSPTU StudyRAG) - Complete Environment Configuration Reference
# ==============================================================================
# Copy this file to '.env' and update the values according to your environment.
# In local development, all variables have safe defaults except GEMINI_API_KEY.

# ------------------------------------------------------------------------------
# 1. Application & Environment Mode
# ------------------------------------------------------------------------------
# APP_NAME: User-facing name of the application. Default: "Arise"
APP_NAME="Arise"

# APP_VERSION: Application release version. Default: "1.0.0"
APP_VERSION="1.0.0"

# ENV: Environment mode. Options: "development", "production".
# When set to "production" with AUTH_ENABLED=true, SESSION_SECRET is strictly required at startup.
# Default: "development"
ENV="development"

# ENABLE_DOCS: Toggle FastAPI interactive docs (/docs, /redoc, /openapi.json).
# Recommended: set to "false" in public production environments. Default: "true"
ENABLE_DOCS=true

# ------------------------------------------------------------------------------
# 2. LLM Provider & Credentials
# ------------------------------------------------------------------------------
# LLM_PROVIDER: LLM backend provider. Options: "auto", "gemini", "mock".
# "auto" uses Gemini when GEMINI_API_KEY is present, or mock synthesis otherwise.
# "mock" runs offline without external network calls (ideal for benchmarks and CI).
# Default: "auto"
LLM_PROVIDER="gemini"

# GEMINI_API_KEY: Google Gemini API key (from https://aistudio.google.com).
# Required for live generative responses. If empty/unset, system uses grounded fallback passages.
GEMINI_API_KEY="your_gemini_api_key_here"

# GEMINI_MODEL: Specific Gemini model variant for generation.
# Supported: "gemini-3.5-flash-lite", "gemini-3.5-flash". Default: "gemini-3.5-flash-lite"
GEMINI_MODEL="gemini-3.5-flash-lite"

# ------------------------------------------------------------------------------
# 3. Vector Database & Storage
# ------------------------------------------------------------------------------
# VECTOR_STORE_TYPE: Storage backend for vector embeddings. Options: "chroma".
# Default: "chroma"
VECTOR_STORE_TYPE="chroma"

# CHROMA_PERSIST_DIR: Local directory path where ChromaDB persists embeddings on disk.
# Default: "./chroma_db"
CHROMA_PERSIST_DIR="./chroma_db"

# UPLOAD_DIR: Local directory where uploaded syllabus and course notes PDFs are saved.
# Default: "./uploads"
UPLOAD_DIR="./uploads"

# ------------------------------------------------------------------------------
# 4. RAG Retrieval & Confidence Guardrail Parameters
# ------------------------------------------------------------------------------
# SIMILARITY_THRESHOLD: Cosine similarity cutoff [0.0 - 1.0] for the confidence guardrail.
# Queries with similarity below this threshold are rejected as ungrounded to prevent hallucination.
# Default: 0.32
SIMILARITY_THRESHOLD=0.32

# RRF_K: Ranking smoothing constant for Reciprocal Rank Fusion (Hybrid search = Vector + BM25).
# Default: 60
RRF_K=60

# DEFAULT_TOP_K: Default number of relevant chunks retrieved per user question.
# Default: 5
DEFAULT_TOP_K=5

# NEIGHBOR_EXPANSION: When true, retrieves surrounding ±1 page chunks from the same document
# to provide broader pedagogical context to the LLM while keeping citations precise.
# Default: true
NEIGHBOR_EXPANSION=true

# ------------------------------------------------------------------------------
# 5. Authentication & Access Control
# ------------------------------------------------------------------------------
# AUTH_ENABLED: Enforce user authentication across API and UI routes.
# When true: / requires login, /api/* endpoints require valid session (except /health and /auth/*).
# When false: allows anonymous access across all pages. Default: true
AUTH_ENABLED=true

# USERS_DB_PATH: Filepath to SQLite database storing user accounts and roles.
# The parent directory is created automatically on startup. Default: "data/users.db"
USERS_DB_PATH="data/users.db"

# SESSION_SECRET: Secret key used to sign HttpOnly session cookies using HMAC-SHA256.
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
# In development, a random key is generated at startup if unset.
# In production, server startup will fail if unset.
SESSION_SECRET=""

# COOKIE_SECURE: Set Secure flag on session cookies (enforces HTTPS only).
# Set to "true" in production behind HTTPS; leave "false" for local HTTP dev. Default: false
COOKIE_SECURE=false

# ALLOW_SIGNUP: When true, users can register new accounts via /api/auth/register.
# When false, only administrators can provision users. Default: true
ALLOW_SIGNUP=true

# ADMIN_EMAIL: Optional email to automatically bootstrap an administrator account on startup.
# Example: "admin@mrsptu.ac.in". Default: unset
ADMIN_EMAIL=""

# ADMIN_PASSWORD: Password for bootstrapped administrator account (minimum 8 characters).
# Plaintext is hashed with bcrypt and never stored. Default: unset
ADMIN_PASSWORD=""

# DAILY_QUERY_LIMIT: Maximum number of questions a single user can submit per UTC day.
# Set to 0 to disable daily limits (unlimited queries). Default: 0
DAILY_QUERY_LIMIT=0

# ------------------------------------------------------------------------------
# 6. Deployment, Network & Security Limits
# ------------------------------------------------------------------------------
# PORT: TCP port the application listens on (used by Dockerfile CMD and start scripts).
# Default: 8000
PORT=8000

# ADMIN_TOKEN: Optional bearer token for programmatic management (POST /ingest, DELETE /documents).
# If set, requests with matching 'X-Admin-Token' header can bypass role checks (for CI/CD scripts).
# Default: unset (admin role session cookie required)
ADMIN_TOKEN=""

# RATE_LIMIT_PER_HOUR: Max /api/query requests allowed per client IP per rolling 1-hour window.
# Automatically extracts client IP behind proxies (X-Forwarded-For). Set to 0 to disable.
# Default: 0
RATE_LIMIT_PER_HOUR=0

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins.
# Example: "https://arise.mrsptu.ac.in,http://localhost:3000". Default: "*" (wildcard regex with credentials)
ALLOWED_ORIGINS="*"

# MAX_UPLOAD_MB: Maximum allowed syllabus PDF file size in megabytes.
# Uploads exceeding this limit receive a 413 Payload Too Large response. Default: 25
MAX_UPLOAD_MB=25
